# ==========================================
# LabelLens — Environment Configuration Example
# ==========================================

# 1. Backend Service Configuration (FastAPI)
PORT=8000
LOG_LEVEL=INFO
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 2. Database Configuration
# Provide your MongoDB Atlas connection string, or leave empty/"none" for built-in persistent storage
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/labellens?retryWrites=true&w=majority
MONGODB_URI=none
MONGODB_DATABASE=labellens

# 3. External Food Integrations
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org

# 4. Web Frontend (Vite) Configuration
# In local development: leave blank or http://127.0.0.1:8000
# In production on Vercel: set to your deployed Render URL (e.g. https://labellens-backend-xxxx.onrender.com)
VITE_API_BASE_URL=http://127.0.0.1:8000

# 5. Mobile Application (Expo) Configuration
# For Android Emulator: http://10.0.2.2:8000
# For iOS Simulator / Web: http://127.0.0.1:8000
# For Physical Phone: http://<your-computer-local-wifi-ip>:8000
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
